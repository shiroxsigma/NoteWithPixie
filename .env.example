# このファイルを .env にコピーして環境に合わせて編集してください。

# --- LLM バックエンド（OpenAI 互換エンドポイント）---
# Ollama:    http://localhost:11434/v1
# LM Studio: http://localhost:1234/v1
NWP_LLM_BASE_URL=http://localhost:11434/v1
NWP_LLM_API_KEY=not-needed
NWP_CHAT_MODEL=qwen2.5:7b-instruct

# --- ファイル参照ルート（この外は一切触れない）---
NWP_WORKSPACE_ROOT=./workspace

# --- サーバ ---
NWP_HOST=127.0.0.1
NWP_PORT=8765

# ripgrep のパス（PATH にあれば変更不要）
NWP_RG_PATH=rg

# --- エージェントモード ---
# true: チャットがワークスペース参照・Copilot 相談ツールを自律的に使う
NWP_AGENT_MODE=true
NWP_AGENT_MAX_STEPS=6
NWP_TOOL_RESULT_MAX_CHARS=8000

# --- PrayLight（Copilot 相談ツール）---
# ask_copilot ツールが subprocess で {NWP_PRAYLIGHT_DIR}/copilot_ask.py を呼ぶ。
# 事前に PrayLight 側で `python start_browser.py` を実行してログインしておくこと。
NWP_PRAYLIGHT_DIR=../PrayLight
# 空なら {NWP_PRAYLIGHT_DIR}/.venv/Scripts/python.exe を使う
NWP_PRAYLIGHT_PYTHON=
NWP_COPILOT_TIMEOUT=120
